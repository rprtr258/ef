# Mixed-arity handler: 0-arg op case + Return case. The resume binders of
# unequal-arity rows must land in disjoint hframe slots.
Get :: effect(): i64;

s := 3;

down :: fn(): i64 ! { Get } {
  Get!();
  Get!();
  s
};

Println!(handle {
  down()
} case Get() => k {
  k(s)
} case Return(v) => k {
  v
})
