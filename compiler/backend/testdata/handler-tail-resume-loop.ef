# Tail-resumption loop: every iteration resumes through the same boundary;
# the pending completion continuations must not chain across iterations.
effect Get(): i64;

s := 40;

down :: fn(): i64 ! { Get } {
  i := Get!();
  if (i == 0) {
    i
  } else {
    s = i - 1;
    down()
  }
};

handle {
  down()
} case Get() => k {
  k(s)
} case Return(v) => k {
  v
}
