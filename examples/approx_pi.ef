argv :: args();
if (len(argv) != 1) {
  Out!("Usage: ef run examples/approx_pi.ef <n>\n");
  Exit!(1)
}
n :: number(get(argv, 0));
if (n <= 0) { Out!("Incorrect n value\n"); Exit!(1) }

p := 0;
each(fn(_, _) {
  x :: Random!();
  y :: Random!();
  if (x * x + y * y <= 1) {
    p = p + 1;
  }
}, range(1, @as(n, i64), 1));

pi :: 4 * p / n;
Println!(pi);
