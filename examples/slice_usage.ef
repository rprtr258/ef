# Slices: `[T]` is a fat pointer {backing, offset, length}. Build by
# appending with concat (fresh backing); sub returns a zero-copy view
# sharing the backing; len reads the view length, get reads through the
# view's window.

slice: [i64] = [];
slice = concat(slice, [1]);  # append 1
slice = concat(slice, [2]);  # append 2
slice = concat(slice, [3]);  # append 3

len_ :: len(slice);
elem :: get(slice, 0);
s :: sub(slice, 1, 2);       # view of [1, 2): shares the backing, no copy
Println!(elem + len_ + len(s))
