# Closures: a fn value carries the environment it was created in. The
# `adder` returned by closure(3) closes over x = 3 and keeps reading it
# after closure has returned, so add3(4) computes 3 + 4.

add :: fn(x: i64, y: i64) { x + y };

closure :: fn(x) {
  adder :: fn(y) { add(x, y) };
  adder
};

add3 :: closure(3);
Println!(add3(4));
