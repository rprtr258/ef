# Renders a rotating 3D star polygon to the terminal with ANSI cursor control.
#
#   ef run examples/star.ef <num_of_vertices> <draw_step>
#   <draw_step> must be in range (0 .. <num_of_vertices> / 2)
#
# Records are represented as homogeneous arrays: a Point is [x, y, z] : [f64],
# a matrix is [[f64]]. The grid is a mutable [[string]] indexed via get/set.

GRID_SIZE :: 50;
radius :: 20;
SIZE :: GRID_SIZE * 2 + 1;
m_grid :: map(fn(_) {map(fn(_) {" "}, range(0, SIZE, 1))}, range(0, SIZE, 1));

paint :: fn(x: i64, y: i64, color: string): unit {
  gx :: x + GRID_SIZE;
  gy :: GRID_SIZE - y;
  set(get(m_grid, gx), gy, color)
};

line :: fn(x1: f64, y1: f64, x2: f64, y2: f64, color: string): unit {
  dx :: (x2 - x1) / 100.0;
  dy :: (y2 - y1) / 100.0;
  c := [x1, y1];
  while (abs(c.0 - x2) > 0.01 || abs(c.1 - y2) > 0.01) {
    c = [c.0 + dx, c.1 + dy];
    paint(round(c.0), round(c.1), color)
  }
};

clear :: fn(): unit {
  each(fn(i, _) {
    each(fn(j, _) {
      paint(i, j, " ")
    }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1))
  }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
  line(0, @as(0 - GRID_SIZE, f64), 0, @as(GRID_SIZE, f64), "|");
  line(@as(0 - GRID_SIZE, f64), 0, @as(GRID_SIZE, f64), 0, "-");
  paint(0, 0, "O");
  paint(0, GRID_SIZE / 3, "^");
  paint(GRID_SIZE, 0, ">")
};

V3 :: [f64, f64, f64];
M3x3 :: [V3, V3, V3];

drawPolygon :: fn(points: [V3]): unit {
  n :: len(points);
  idx :: map(fn(i): [i64, i64] {[i, (i + 1) % n]}, range(0, n, 1));
  each(fn(ij: [i64, i64], _) {
    [i, j] :: ij;
    p :: get(points, i);
    q :: get(points, j);
    paint(round(p.0), round(p.1), "*");
    line(p.0, p.1, q.0, q.1, "*")
  }, idx)
};

printGrid :: fn(): unit {
  each(fn(y, _) {
    each(fn(x, _) {
      Out!(get(get(m_grid, x + GRID_SIZE), GRID_SIZE - y))
    }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
    Out!("\n")
  }, range(radius, 0 - radius - 1, 0 - 1))
};

# --- 3x3 matrix * point ---
apply :: fn(p: V3, m: M3x3): V3 {
  x :: p.0 * m.0.0 + p.1 * m.0.1 + p.2 * m.0.2;
  y :: p.0 * m.1.0 + p.1 * m.1.1 + p.2 * m.1.2;
  z :: p.0 * m.2.0 + p.1 * m.2.1 + p.2 * m.2.2;
  [x, y, z]
};

argv :: args();
if (len(argv) != 4) {
  Out!("Usage: ef run examples/star.ef <num_of_vertices> <draw_step>\n<draw_step> must be in range (0..<num_of_vertices> / 2)\n");
  Exit!(1)
}
vertices :: round(number(get(argv, 2)));
step :: round(number(get(argv, 3)));
if (vertices <= 0) { Out!("Incorrect vertices value\n"); Exit!(1) }
if (step < 0 || step > vertices / 2) { Out!("Incorrect step value\n"); Exit!(1) }

poly := flatmap(fn(i, _) {
  map(fn(t): V3 {
    k :: i + step * t;
    angle :: 2.0 * PI * @as(k, f64) / @as(vertices, f64) + PI / 2.0;
    [
      @as(round(radius * cos(angle)), f64),
      @as(round(radius * sin(angle)), f64),
      0.0
    ]
  }, range(0, vertices, 1))
}, range(0, vertices, 1));

rotAroundZOrY :: false;
rotateSpeed :: 0.05;

Out!("\x1B[?25l");
while (true) {
  poly = map(fn(p) {
    if (rotAroundZOrY) {
      p
    } else {
      apply(p, [
        [cos(rotateSpeed), 0.0, -sin(rotateSpeed)],
        [0.0, 1.0, 0.0],
        [sin(rotateSpeed), 0.0, cos(rotateSpeed)]
      ])
    }
  }, poly);
  poly = map(fn(p) {
    apply(p, [
      [cos(rotateSpeed), -sin(rotateSpeed), 0.0],
      [sin(rotateSpeed), cos(rotateSpeed), 0.0],
      [0.0, 0.0, 1.0]
    ])
  }, poly);
  drawPolygon(poly);
  printGrid();
  clear();
  each(fn(_, _) { Out!("\x1B[1A") }, range(0, radius * 2 + 1, 1));
  # Wait!(0.001)
}
