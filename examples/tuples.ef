# Tuples: positional bracket literals, .N/.name field access, and a
# declared tuple type flowing into a homogeneous literal (vec3_add's
# [f64, f64, f64] return keeps [a.0 + b.0, ...] a tuple). An empty
# function body returns unit.

vec3_add :: fn(a: [f64, f64, f64], b: [f64, f64, f64]): [f64, f64, f64] {
  [a.0 + b.0, a.1 + b.1, a.2 + b.2]
};

do_nothing :: fn() { };  # empty body -> unit

named :: fn(): i64 {
  point: [x: i64, y: i64] : [10, 20];  # fields named in the type
  x :: point.x;
  y :: point.y;
  y - x
};

# the same shape, expressed with the field access order swapped
named_reorder :: fn(): i64 {
  point: [x: i64, y: i64] : [10, 20];
  x :: point.x;
  y :: point.y;
  y - x
};

t: [i64, f64] : [42, 3.14];  # heterogeneous -> tuple
do_nothing();
v1: [f64, f64, f64] : [1.0, 2.0, 3.0];
v2: [f64, f64, f64] : [4.0, 5.0, 6.0];
v3: [f64, f64, f64] : vec3_add(v1, v2);
x :: named();
y :: named_reorder();
round(v3.0 + v3.1 + v3.2) + x + y
