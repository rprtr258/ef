# Numeric widths: ef has six — i32, i64, u32, u64, f32, f64. Arithmetic
# between distinct widths is a type error; @as(expr, T) converts (float ->
# int truncates toward zero, bool -> numeric gives 0/1, the rest preserve
# the value). Untyped literals (`1`, `1.5`) flex to whatever numeric
# context demands and default to i64 / f64.

check_bool :: fn(): bool {
  a :: true && false;  # false
  b :: true || false;  # true
  c :: true != false;  # bool xor: true
  !a && b && c            # !false && true && true -> true
};

check_i32 :: fn(): i32 {
  d :: 4 * 2;  # left shift by 1: 8
  e :: 8 / 2;  # right shift by 1: 4
  d + e
};

check_i64 :: fn(): i64 {
  d :: 4 * 2;  # 8
  e :: 8 / 2;  # 4
  d + e
};

# the widths must agree: the i64 checks convert with @as before summing
Println!((if (check_bool()) { 1 } else { 0 }) + check_i32() + @as(check_i64(), i32))
