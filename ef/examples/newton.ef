// Newton's method for square roots.
// makeNewtonRoot(precision) returns a root finder that iterates until
// |guess^2 - x| < precision (a real tolerance, not a step count):
//   guess_{n+1} = (guess_n + x / guess_n) / 2

let makeNewtonRoot = fn(precision: float): (float) -> float {
  let find = fn(x: float): float {
    let guess = x/2;
    let done = false;
    while (!done) {
      let diff = guess * guess - x;
      let adiff = if (diff < 0) { -diff } else { diff };
      if (adiff < precision) {
        done = true
      } else {
        guess = (guess + x / guess) / 2
      }
    }
    guess
  };
  find
};

let sqrt = makeNewtonRoot(0.0001);
Println!(sqrt(2))
