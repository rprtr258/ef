# Newton's method for square roots.
# makeNewtonRoot(precision) returns a root finder that iterates until
# |guess^2 - x| < precision (a real tolerance, not a step count):
#   guess_{n+1} = (guess_n + x / guess_n) / 2

makeNewtonRoot :: fn(precision: f64): (f64) -> f64 {
  find :: fn(x: f64): f64 {
    guess := x/2;
    done := false;
    while (!done) {
      diff :: guess * guess - x;
      adiff :: if (diff < 0) { -diff } else { diff };
      if (adiff < precision) {
        done = true
      } else {
        guess = (guess + x / guess) / 2
      }
    }
    guess
  };
  find
};

root :: makeNewtonRoot(0.0001);
Println!(root(2))
