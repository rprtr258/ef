vec3_add :: fn(a: [f32, f32, f32], b: [f32, f32, f32]): [f32, f32, f32] {
  return [a.0 + b.0, a.1 + b.1, a.2 + b.2];
};

do_nothing :: fn(): [] {
};

named :: fn(): i32 {
  point : [x: i32, y: i64] = [x = 10i32, y = 20i64];
  x : i32 = point.x;
  y : i64 = point.y;
  return @as(y, i32) - x;
};

# same as named, but initial literal fields are reordered
named_reorder :: fn(): i32 {
  point : [x: i32, y: i64] = [y = 20i64, x = 10i32];
  x : i32 = point.x;
  y : i64 = point.y;
  return @as(y, i32) - x;
};

main :: fn(): i32 {
  t : [i32, f64] = [42i32, 3.14f64];
  do_nothing();
  v1 : [f32, f32, f32] = [1.0f32, 2.0f32, 3.0f32];
  v2 : [f32, f32, f32] = [4.0f32, 5.0f32, 6.0f32];
  v3 : [f32, f32, f32] = vec3_add(v1, v2);
  x : i32 = named();
  y : i32 = named_reorder();
  return @as(v3.0 + v3.1 + v3.2, i32) + x + y;
};