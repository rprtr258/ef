# Test basic GC features
test_parser :: fn(): i32 {
  # Test pointer operations
  x: i32 = 42;
  ptr: @Ptr(i32) = x.&;
  y: i32 = ptr.*;

  # Test slice operations
  slice: @slice(i32) = @slice.make(i32);
  slice = @slice.append(slice, 42);
  len: i32 = slice.len;

  return y;
};

test_basic :: fn(): i32 {
  # Test struct (named tuple)
  point: [x: i32, y: i32] = [x: 10, y: 20];
  x_val: i32 = point.x;
  y_val: i32 = point.y;

  # Test slice basics
  slice: @slice(i32) = @slice.make(i32);
  slice_len: i32 = slice.len;  # Should be 0
  slice_cap: i32 = slice.cap;  # Should be 0

  # Test slice append
  slice = @slice.append(slice, 42);
  new_len: i32 = slice.len;  # Should be 1

  # Test slice element access
  elem: i32 = slice.(0);  # Should be 42

  return x_val + y_val + slice_len + slice_cap + new_len + elem;
};

main :: fn(): i32 {
  return test_parser() + test_basic();
};
