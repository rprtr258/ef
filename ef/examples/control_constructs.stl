index :: [log: fn(x: i32): void];

check_if :: fn(): i32 {
  x: i32 = 0;
  if x < 10 {
    x = x + 1;
  } else {
    x = x - 1;
  }
  return x;
};

check_var_inside_if :: fn(): i32 {
  x: i32 = 0;
  if x < 10 {
    y: i32 = 42;
  }
  return x;
};

check_while :: fn(): i32 {
  x: i32 = 0;
  while x < 10 {
    x = x + 1;
  }
  return x;
};

check_nested_while :: fn(): i32 {
  x: i32 = 0;
  while x < 10 {
    x = x + 1;
    while x < 20 {
      x = x * 2;
    }
  }
  return x;
};

check_break_continue :: fn(): i32 {
  x: i32 = 1234;
  while true {
    index.log(x);
    if x % 2 == 1 {
      x = x * 3 + 1;
      continue;
    }
    x = x / 2;
    if x == 1 {
      break;
    }
  }
  return x;
};

main :: fn(): i32 {
  return check_if() + check_var_inside_if() + check_while() + check_nested_while() + check_break_continue();
};