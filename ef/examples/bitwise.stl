check_bool :: fn(): bool {
  # Test & | ^ on bool
  a: bool = true & false; # false
  b: bool = true | false; # true
  c: bool = true ^ false; # true
  return !a & b & c; # !0 * 1 * 1 = 1
};

check_i32 :: fn(): i32 {
  # Test & | ^ << >> on i32
  a: i32 = 5 & 3;  # 1
  b: i32 = 6 | 2;  # 6
  c: i32 = 5 ^ 3;  # 6
  d: i32 = 4 << 1; # 8
  e: i32 = 8 >> 1; # 4
  return a + b + c + d + e; # 1+6+6+8+4 = 25
};

check_i64 :: fn(): i64 {
  a: i64 = 5i64 & 3i64;  # 1
  b: i64 = 6i64 | 2i64;  # 6
  c: i64 = 5i64 ^ 3i64;  # 6
  d: i64 = 4i64 << 1i64; # 8
  e: i64 = 8i64 >> 1i64; # 4
  return a + b + c + d + e; # 25
};

main :: fn(): i32 {
  # Test & | ^ << >> on i64
  return @as(check_bool(), i32) + check_i32() + @as(check_i64(), i32);
};