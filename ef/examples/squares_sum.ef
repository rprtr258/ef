# Sums the squares of 1..4 with a left fold: 1² + 2² + 3² + 4² = 30.

# accumulates left-to-right: it calls f with the current
# element first and the accumulator second, looping over indices; the
# empty list yields z.
let foldl = fn(f, z, xs) {
  let acc = z;
  let i = 0;
  while (i < len(xs)) {
    acc = f(get(xs, i), acc);
    i = i + 1;
  };
  acc
};

let sqr = fn(x: int): int { x * x };
let sqrs = map(sqr, range(1, 5, 1));

foldl(fn(x, acc) { x + acc }, 0, sqrs)
