# Element store and sub-views: set(xs, i, v) writes through the view into
# the shared backing (strictly in-window: it never grows the slice);
# sub(xs, from, to) returns a zero-copy view of the range [from, to).

slice: [i64] = [];
slice = concat(slice, [42]);  # append 42

i := 0;
set(slice, i, get(slice, 0) + 1);  # store through the variable index

sub(slice, 1, 1);                  # empty view past the last element
get(slice, 0)
