# Element store and sub-ranges: set(xs, i, v) writes an element in place;
# ef has no built-in sub-range primitive, so sub rebuilds the range
# [from, to) with a loop, clamped to the array's length.

let sub = fn(xs: [i64], from: i64, to: i64): [i64] {
  let out: [i64] = [];
  let i = from;
  while (i < to && i < len(xs)) {  # clamped on short arrays
    out = concat(out, [get(xs, i)]);
    i = i + 1;
  };
  out
};

let slice: [i64] = [];
slice = concat(slice, [42]);  # append 42

let i = 0;
set(slice, i, get(slice, 0) + 1);  # store through the variable index

sub(slice, 1, 2);                  # sub-range [1, 2) of a one-element array
0
