a :: fn(
  k: i32,
  x1: fn(): i32,
  x2: fn(): i32,
  x3: fn(): i32,
  x4: fn(): i32,
  x5: fn(): i32
): i32 {
  b: fn(): i32 = fn(): i32 {
    k = k - 1;
    return a(k, b, x1, x2, x3, x4);
  };
  if k > 0 {
    return b();
  } else {
    return x4() + x5();
  }
};

x :: fn(n: i32): fn(): i32 {
  return fn(): i32 {
    return n;
  };
};

main :: fn(): i32 {
  return a(10, x(1), x(-1), x(-1), x(1), x(0));
};
