main :: fn(): i32 {
  # Binary
  bin_i32_untyped: i32 = 0b1010;    # 10
  bin_i32:         i32 = 0b1010i32; # 10
  bin_i64:         i64 = 0b1010i64; # 10
  bin_u32:         u32 = 0b1010u32; # 10
  bin_u64:         u64 = 0b1010u64; # 10
  # Hex
  hex_i32_untyped: i32 = 0xFF;      # 255
  hex_i32:         i32 = 0xFFi32;   # 255
  hex_i64:         i64 = 0xFFi64;   # 255
  hex_u32:         u32 = 0xFFu32;   # 255
  hex_u64:         u64 = 0xFFu64;   # 255
  # Scientific
  sci_f32_untyped: f32 = 1.23e2;       # 123
  sci_f32:         f32 = 1.23e2f32;    # 123
  sci_f64:         f64 = 1.23e2f64;    # 123
  return bin_i32_untyped + bin_i32 + @as(bin_i64, i32) + @as(bin_u32, i32) + @as(bin_u64, i32) +
         hex_i32_untyped + hex_i32 + @as(hex_i64, i32) + @as(hex_u32, i32) + @as(hex_u64, i32) +
         @as(sci_f32_untyped, i32) + @as(sci_f32, i32) + @as(sci_f64, i32);
};