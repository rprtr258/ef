# Renders a rotating 3D star polygon to the terminal with ANSI cursor control.
#
#   ef run examples/star.ef <num_of_vertices> <draw_step>
#   <draw_step> must be in range (0 .. <num_of_vertices> / 2)
#
# Records are represented as homogeneous arrays: a Point is [x, y, z] : [f64],
# a matrix is [[f64]]. The grid is a mutable [[string]] indexed via get/set.

let GRID_SIZE = 50;
let radius = 20;
let SIZE = GRID_SIZE * 2 + 1;
let m_grid = map(fn(_) {map(fn(_) {" "}, range(0, SIZE, 1))}, range(0, SIZE, 1));

let paint = fn(x: f64, y: f64, color: string): unit {
  let gx = round(x) + GRID_SIZE;
  let gy = GRID_SIZE - round(y);
  set(get(m_grid, gx), gy, color)
};

let line = fn(x1: f64, y1: f64, x2: f64, y2: f64, color: string): unit {
  let dx = (x2 - x1) / 100.0;
  let dy = (y2 - y1) / 100.0;
  let c = [x1, y1];
  while (abs(c.0 - x2) > 0.01 || abs(c.1 - y2) > 0.01) {
    c = [c.0 + dx, c.1 + dy];
    paint(round(c.0), round(c.1), color)
  }
};

let clear = fn(): unit {
  each(fn(i, _) {
    each(fn(j, _) {
      paint(i, j, " ")
    }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1))
  }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
  line(0, -GRID_SIZE, 0, GRID_SIZE, "|");
  line(-GRID_SIZE, 0, GRID_SIZE, 0, "-");
  paint(0, 0, "O");
  paint(0, GRID_SIZE/3, "^");
  paint(GRID_SIZE, 0, ">")
};

type V3 = [f64, f64, f64];
type M3x3 = [V3, V3, V3];

let drawPolygon = fn(points: [V3]): unit {
  let n = len(points);
  let idx = map(fn(i): [i64, i64] {[i, (i + 1) % n]}, range(0, n, 1));
  each(fn(ij: [i64, i64], _) {
    let [i, j] = ij;
    let p = get(points, i);
    let q = get(points, j);
    paint(p.0, p.1, "*");
    line(p.0, p.1, q.0, q.1, "*")
  }, idx)
};

let printGrid = fn(): unit {
  each(fn(y, _) {
    each(fn(x, _) {
      Out!(get(get(m_grid, x + GRID_SIZE), GRID_SIZE - y))
    }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
    Out!("\n")
  }, range(radius, 0 - radius - 1, 0 - 1))
};

# --- 3x3 matrix * point ---
let apply = fn(p: V3, m: M3x3): V3 {
  let x = p.0 * m.0.0 + p.1 * m.0.1 + p.2 * m.0.2;
  let y = p.0 * m.1.0 + p.1 * m.1.1 + p.2 * m.1.2;
  let z = p.0 * m.2.0 + p.1 * m.2.1 + p.2 * m.2.2;
  [x, y, z]
};

let argv = args();
if (len(argv) != 4) {
  Out!("Usage: ef run examples/star.ef <num_of_vertices> <draw_step>\n<draw_step> must be in range (0..<num_of_vertices> / 2)\n");
  Exit!(1)
}
let vertices = round(number(get(argv, 2)));
let step = round(number(get(argv, 3)));
if (vertices <= 0) { Out!("Incorrect vertices value\n"); Exit!(1) }
if (step < 0 || step > vertices / 2) { Out!("Incorrect step value\n"); Exit!(1) }

let poly = flatmap(fn(i, _) {
  map(fn(t): V3 {
    let k = i + step * t;
    let angle = 2.0 * PI * k / vertices + PI / 2.0;
    [
      round(radius * cos(angle)),
      round(radius * sin(angle)),
      0.0
    ]
  }, range(0, vertices, 1))
}, range(0, vertices, 1));

let rotAroundZOrY = false;
let rotateSpeed = 0.05;

Out!("\x1B[?25l");
while (true) {
  poly = map(fn(p) {
    if (rotAroundZOrY) {
      p
    } else {
      apply(p, [
        [cos(rotateSpeed), 0.0, -sin(rotateSpeed)],
        [0.0, 1.0, 0.0],
        [sin(rotateSpeed), 0.0, cos(rotateSpeed)]
      ]);
    };
  }, poly);
  poly = map(fn(p) {
    apply(p, [
      [cos(rotateSpeed), -sin(rotateSpeed), 0.0],
      [sin(rotateSpeed), cos(rotateSpeed), 0.0],
      [0.0, 0.0, 1.0]
    ])
  }, poly);
  drawPolygon(poly);
  printGrid();
  clear();
  each(fn(_, _) { Out!("\x1B[1A") }, range(0, radius * 2 + 1, 1));
  # Wait!(0.001)
}
