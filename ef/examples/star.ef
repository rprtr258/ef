// Port of ink/samples/star.ink to ef.
// Renders a rotating 3D star polygon to the terminal with ANSI cursor control.
//
//   ef run examples/star.ef <num_of_vertices> <draw_step>
//   <draw_step> must be in range (0 .. <num_of_vertices> / 2)
//
// Records are represented as homogeneous arrays: a Point is [x, y, z] : [float],
// a matrix is [[float]]. The grid is a mutable [[string]] indexed via get/set.

let GRID_SIZE = 50;
let radius = 20;
let SIZE = GRID_SIZE * 2 + 1;

// --- grid (mutable [[string]]) ---

fn makeRow(n: int): [string] {
  let r = [];
  let i = 0;
  while (i < n) { r = concat(r, [" "]); i = i + 1 }
  r
}
fn makeGrid(rows: int, cols: int): [[string]] {
  let g = [];
  let i = 0;
  while (i < rows) { g = concat(g, [makeRow(cols)]); i = i + 1 }
  g
}
let m_grid = makeGrid(SIZE, SIZE);

fn paint(x: float, y: float, color: string): null {
  let gx = round(x) + GRID_SIZE;
  let gy = GRID_SIZE - round(y);
  set(get(m_grid, gx), gy, color)
}

fn line(x1: float, y1: float, x2: float, y2: float, color: string): null {
  let dx = (x2 - x1) / 100.0;
  let dy = (y2 - y1) / 100.0;
  let cx = x1;
  let cy = y1;
  while (abs(cx - x2) > 0.01 || abs(cy - y2) > 0.01) {
    cx = cx + dx;
    cy = cy + dy;
    paint(round(cx), round(cy), color)
  }
}

fn clear(): null {
  each(fn(i, _) {
    each(fn(j, _) { paint(i, j, " ") }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1))
  }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
  each(fn(y, _) { paint(0, y, "|") }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
  each(fn(x, _) { paint(x, 0, "-") }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
  paint(0, 0, "O");
  paint(0, GRID_SIZE, "^");
  paint(GRID_SIZE, 0, ">")
}

fn drawPolygon(points: [[float]]): null {
  let n = len(points);
  each(fn(i, _) {
    let p = get(points, i);
    let q = get(points, (i + 1) % n);
    paint(get(p, 0), get(p, 1), "*");
    line(get(p, 0), get(p, 1), get(q, 0), get(q, 1), "*")
  }, range(0, n, 1))
}

fn printGrid(): null {
  each(fn(y, _) {
    each(fn(x, _) {
      perform Out(get(get(m_grid, x + GRID_SIZE), GRID_SIZE - y))
    }, range(0 - GRID_SIZE, GRID_SIZE + 1, 1));
    perform Out("\n")
  }, range(radius, 0 - radius - 1, 0 - 1))
}

// --- 3x3 matrix * point ---

fn apply(p: [float], m: [[float]]): [float] {
  let x = get(p, 0) * get(get(m, 0), 0) + get(p, 1) * get(get(m, 0), 1) + get(p, 2) * get(get(m, 0), 2);
  let y = get(p, 0) * get(get(m, 1), 0) + get(p, 1) * get(get(m, 1), 1) + get(p, 2) * get(get(m, 1), 2);
  let z = get(p, 0) * get(get(m, 2), 0) + get(p, 1) * get(get(m, 2), 1) + get(p, 2) * get(get(m, 2), 2);
  [x, y, z]
}

// --- main ---

let argv = args();
if (len(argv) != 4) {
  perform Out("Usage: ef run examples/star.ef <num_of_vertices> <draw_step>\n<draw_step> must be in range (0..<num_of_vertices> / 2)\n");
  exit(1)
}
let vertices = round(number(get(argv, 2)));
let step = round(number(get(argv, 3)));
if (vertices <= 0) { perform Out("Incorrect vertices value\n"); exit(1) }
if (step < 0 || step > vertices / 2) { perform Out("Incorrect step value\n"); exit(1) }

let poly = flatmap(fn(i, _) {
  map(fn(t) {
    let k = i + step * t;
    [
      round(radius * cos(2.0 * PI * k / vertices + PI / 2.0)),
      round(radius * sin(2.0 * PI * k / vertices + PI / 2.0)),
      0.0
    ]
  }, range(0, vertices, 1))
}, range(0, vertices, 1));

let rotAroundZOrY = false;
let rotateSpeed = 0.05;

perform Out("\x1B[?25l");
while (true) {
  poly = if (rotAroundZOrY) {
    map(fn(p) { apply(p, [
      [cos(rotateSpeed), -sin(rotateSpeed), 0.0],
      [sin(rotateSpeed), cos(rotateSpeed), 0.0],
      [0.0, 0.0, 1.0]
    ]) }, poly)
  } else {
    map(fn(p) {
      let q = apply(p, [
        [cos(rotateSpeed), 0.0, -sin(rotateSpeed)],
        [0.0, 1.0, 0.0],
        [sin(rotateSpeed), 0.0, cos(rotateSpeed)]
      ]);
      apply(q, [
        [cos(rotateSpeed), -sin(rotateSpeed), 0.0],
        [sin(rotateSpeed), cos(rotateSpeed), 0.0],
        [0.0, 0.0, 1.0]
      ])
    }, poly)
  };
  drawPolygon(poly);
  printGrid();
  clear();
  each(fn(_, _) { perform Out("\x1B[1A") }, range(0, radius * 2 + 1, 1));
  // wait(0.001)
}
