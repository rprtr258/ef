{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ef",
  "scopeName": "source.ef",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#effect-ops"},
    {"include": "#declarations"},
    {"include": "#keywords"},
    {"include": "#numeric-widths"},
    {"include": "#numbers"},
    {"include": "#directives"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "match": "#[^\\n]*",
      "name": "comment.line.number-sign.ef"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.ef",
      "patterns": [
        {"match": "\\\\.", "name": "constant.character.escape.ef"}
      ]
    },
    "effect-ops": {
      "comment": "Op!(...) performs effect Op; the `!` must not be the `!=` operator",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(!)(?!=)",
      "captures": {
        "1": {"name": "entity.name.function.effect.ef"},
        "2": {"name": "keyword.operator.effect.ef"}
      }
    },
    "declarations": {
      "match": "::|:=|:",
      "name": "keyword.operator.declaration.ef"
    },
    "keywords": {
      "patterns": [
        {"match": "\\b(?:if|else|while|handle|case)\\b", "name": "keyword.control.ef"},
        {"match": "\\b(?:fn|effect|type)\\b", "name": "keyword.declaration.ef"},
        {"match": "\\b(?:true|false|unit)\\b", "name": "constant.language.ef"}
      ]
    },
    "numeric-widths": {
      "match": "\\b(?:i32|i64|u32|u64|f32|f64|string|bool)\\b",
      "name": "support.type.ef"
    },
    "numbers": {
      "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.ef"
    },
    "directives": {
      "match": "@as\\b",
      "name": "keyword.other.directive.ef"
    },
    "operators": {
      "match": "==|!=|<=|>=|&&|\\|\\||=>|[+\\-*/%<>=@,;.]",
      "name": "keyword.operator.ef"
    }
  }
}
