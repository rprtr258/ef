# Bench: doubly-recursive Fibonacci from effect-handlers-bench (large input
# 42 -> 267914296 = F(42); the suite's description claims F(43), which all
# implementations, ef included, do not compute). No effects — the suite's pure
# call-stack benchmark at a deeper depth than fib.ef.
fib :: fn(n: i64): i64 {
  if (n < 2) {
    n
  } else {
    fib(n - 1) + fib(n - 2)
  }
};

av := args();
vi :: if (len(av) > 0) { @as(number(get(av, 0)), i64) } else { 42 };

Println!(fib(vi))
