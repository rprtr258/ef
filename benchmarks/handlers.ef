# Bench: effect perform/handle round-trips. Each loop iteration performs
# Tick! and the handler resumes the continuation with acc + 1 — a shallow
# continuation capture per iteration. Regression control for the effect
# path.
effect Tick(acc: i64): i64;

go :: fn(n: i64, acc: i64): i64 ! { Tick } {
  if (n == 0) {
    acc
  } else {
    next := Tick!(acc);
    go(n - 1, next)
  }
};

run :: fn(n: i64): i64 {
  handle {
    go(n, 0)
  } case Tick(acc) => k {
    k(acc + 1)
  } case Return(v) => k {
    v
  }
};

Println!(run(2000))
