# Bench: Knuth's man-or-boy test. Deep mutual recursion through closures
# with mutable capture — boxed frames, all calls load env from the closure
# slot and dispatch indirectly, including lambda-typed parameters.
a :: fn(
  k: i64,
  x1: () -> i64,
  x2: () -> i64,
  x3: () -> i64,
  x4: () -> i64,
  x5: () -> i64
): i64 {
  b :: fn(): i64 {
    k = k - 1;
    a(k, b, x1, x2, x3, x4)
  };
  if (k > 0) {
    b()
  } else {
    x4() + x5()
  }
};

x :: fn(n: i64): () -> i64 {
  fn(): i64 {
    n
  }
};

Println!(a(11, x(1), x(-1), x(-1), x(1), x(0)))
