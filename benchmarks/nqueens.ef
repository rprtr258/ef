# Bench: n-queens counting via backtracking search from effect-handlers-bench
# (large input 12 -> 14200, brute force without heuristics or symmetries).
# Pick! is resumed once per candidate row — each resumption explores that
# candidate's subtree to completion before the next — and the handler sums
# the results; Fail! abandons a dead placement without resuming, so the
# candidate contributes 0. place threads the partial solution as an
# immutable array; the multi-shot discipline freezes it at each perform.
effect Pick(size: i64): i64;
effect Fail(): [i64];

safe :: fn(q: i64, d: i64, xs: [i64]): bool {
  ok := true;
  i := 0;
  dd := d;
  while (i < len(xs)) {
    x := get(xs, i);
    if (q == x || q == x + dd || q == x - dd) {
      ok = false
    };
    i = i + 1;
    dd = dd + 1
  };
  ok
};

place :: fn(n: i64, c: i64): [i64] ! { Pick, Fail } {
  if (c == 0) {
    []
  } else {
    rest := place(n, c - 1);
    q := Pick!(n);
    if (safe(q, 1, rest)) {
      concat([q], rest)
    } else {
      Fail!()
    }
  }
};

run :: fn(n: i64): i64 {
  handle {
    place(n, n)
  } case Fail() => k {
    0
  } case Pick(size) => k {
    a := 0;
    i := 1;
    while (i <= size) {
      a = a + k(i);
      i = i + 1
    };
    a
  } case Return(v) => k {
    1
  }
};

av := args();
vi :: if (len(av) > 0) { @as(number(get(av, 0)), i64) } else { 12 };

Println!(run(vi))
