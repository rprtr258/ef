# Bench: iterator from effect-handlers-bench (large input 40000000 ->
# 800000020000000). Emits 0..n inclusive via Emit! and the handler
# accumulates the sum — one shallow perform/resume per element against a
# module-level cell.
effect Emit(v: i64): unit;

av := args();
vi :: if (len(av) > 0) { @as(number(get(av, 0)), i64) } else { 40000000 };

s := 0;

handle {
  i := 0;
  while (i <= vi) {
    Emit!(i);
    i = i + 1
  }
} case Emit(v) => k {
  s = s + v;
  k(unit)
};
s
