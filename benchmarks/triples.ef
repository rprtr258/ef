# Bench: nondeterministic triple search from effect-handlers-bench (large
# input 300 -> 460212934). choice(n) asks Flip! per candidate level and
# recurses on false; the handler resumes the continuation twice per Flip —
# true, then false — and sums the branch results mod 1000000007. Fail!
# abandons a dead branch without resuming, so it contributes 0 to the
# pending resumption. Valid triples hash as (53a + 2809b + 148877c) mod
# 1000000007; no symmetries, no short-circuiting.
effect Flip(): bool;
effect Fail(): i64;

av := args();
vi :: if (len(av) > 0) { @as(number(get(av, 0)), i64) } else { 300 };
vj :: if (len(av) > 1) { @as(number(get(av, 1)), i64) } else { 300 };

choice :: fn(n: i64): i64 ! { Flip, Fail } {
  if (n < 1) {
    Fail!()
  } else {
    if (Flip!()) {
      n
    } else {
      choice(n - 1)
    }
  }
};

triple :: fn(n: i64, s: i64): i64 ! { Flip, Fail } {
  i := choice(n);
  j := choice(i - 1);
  k := choice(j - 1);
  if (i + j + k == s) {
    (53 * i + 2809 * j + 148877 * k) % 1000000007
  } else {
    Fail!()
  }
};

Println!(handle {
  triple(vi, vj)
} case Flip() => k {
  l := k(true);
  r := k(false);
  (l + r) % 1000000007
} case Fail() => k {
  0
} case Return(v) => k {
  v
})
